---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Página no encontrada">
  <section class="wrap nf">
    <p class="label">error 404</p>
    <h1>Esta página no existe.</h1>
    <a class="btn btn-primary" href={`${base}/`}>Volver al inicio <span class="arrow">→</span></a>
  </section>
</Base>
<style>
  .nf { min-height: 80svh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 20px; padding-top: 100px; }
  h1 { font-size: clamp(44px, 8vw, 96px); letter-spacing: -0.05em; line-height: 0.95; margin: 0; }
</style>
