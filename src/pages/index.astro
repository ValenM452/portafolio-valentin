---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', (p) => !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = site.photo ? (site.photo.startsWith('http') ? site.photo : `${base}${site.photo}`) : '';
const [first, ...lastParts] = site.name.split(' ');
const last = lastParts.join(' ');
---
<Base>
  <!-- Inicio -->
  <section id="inicio" class="hero-wrap">
    <div class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-text">
        <p class="hi mono reveal">
          {site.available && <span class="dot" aria-hidden="true"></span>}
          {site.available ? site.availableText : 'Agenda completa'}
        </p>
        <h1 class="reveal" style="--d:.06s">
          <span class="name">{site.name}</span>
          <span class="role">{site.role}</span>
        </h1>
        <p class="lead reveal" style="--d:.12s">{site.tagline}</p>
        <div class="hero-cta reveal" style="--d:.18s">
          <a class="btn btn-light" href={`${base}/proyectos/`}>Ver proyectos <span class="arrow">↗</span></a>
          {site.cv
            ? <a class="btn btn-ghost" href={`${base}${site.cv}`} download>Descargar CV</a>
            : <a class="btn btn-ghost" href="#contacto">Contactar</a>}
        </div>
        <p class="loc mono reveal" style="--d:.24s">{site.location}</p>
      </div>
      <div class="hero-figure">
        {photo
          ? <img src={photo} alt={`Retrato de ${site.name}`} />
          : <div class="sun" aria-hidden="true"><span>{first[0]}{last[0]}</span></div>}
      </div>
    </div>
  </section>

  <!-- Presentación corta -->
  <section class="section">
    <div class="wrap intro-row">
      <p class="about-text reveal">
        Hola, soy {first}. Vivo en {site.location.split(',')[0]} y {site.intro.charAt(0).toLowerCase()}{site.intro.slice(1)}
      </p>
      <div class="intro-side reveal" style="--d:.1s">
        <p>{site.heroNote}</p>
        <a class="link-arrow" href={`${base}/sobre-mi/`}>Más sobre mí <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Algunos trabajos -->
  <section id="proyectos" class="section">
    <div class="wrap">
      <header class="works-head">
        <h2 class="section-title">Algunos de mis trabajos</h2>
        <p>Cada proyecto tiene su página con lo que hice y cómo. Más código en mi <a href={site.github} target="_blank" rel="noopener">GitHub</a>.</p>
      </header>
      <div class="works">
        {projects.slice(0, 4).map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
      <div class="more">
        <a class="btn" href={`${base}/proyectos/`}>Explorar los {projects.length} proyectos <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <Contact />
</Base>
