---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { services } from '../data/site';
const pad = (n: number) => String(n).padStart(2, '0');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Servicios" description="Tiendas online, sistemas de gestión, sitios de marca e integraciones con IA.">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker mono">Servicios</p>
      <h1>Qué <em>hago.</em></h1>
      <p class="lead-2">Diseño y programo de punta a punta: lo que ve el cliente, el panel donde se maneja el negocio y el servidor que lo sostiene.</p>
    </header>
    <div class="acc">
      {services.map((s, i) => (
        <details class="acc-item" open={i === 0}>
          <summary>
            <span class="mono idx">[{pad(i + 1)}]</span>
            <span class="acc-title">{s.title}</span>
            <span class="acc-icon" aria-hidden="true">↘</span>
          </summary>
          <div class="acc-body">
            <p>{s.text}</p>
            <ul>{s.tags.map((t) => <li class="chip">{t}</li>)}</ul>
          </div>
        </details>
      ))}
    </div>
    <nav class="next-page" aria-label="Siguiente sección">
      <div><small class="mono">Siguiente</small><a href={`${base}/skills/`}>Skills →</a></div>
    </nav>
  </div>
  <Contact />
</Base>
