---
// Tarjeta de vitrina: portada publicitaria grande + título. Lleva a la página del proyecto.
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';

interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
const p = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/proyectos/${project.id}/`;
---
<article class="work reveal" style={`--c:${p.color}; --d:${(index % 2) * 0.08}s`}>
  <a href={href} class="shot" aria-label={`Ver ${p.title}`}>
    <Cover project={project} index={index} />
  </a>
  <div class="info">
    <a href={href} class="go" aria-hidden="true" tabindex="-1">→</a>
    <div class="txt">
      <h3><a href={href}>{p.title}</a></h3>
      <p>{p.category} · {p.year}</p>
    </div>
    {p.live && <a class="live mono" href={p.live} target="_blank" rel="noopener">Visitar ↗</a>}
  </div>
</article>

<style>
  .work { display: flex; flex-direction: column; gap: 16px; }
  .shot { display: block; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(0,0,0,.8); transition: transform .5s cubic-bezier(.2,.7,.2,1), box-shadow .5s, border-color .3s; }
  .shot :global(.cover) { transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .work:hover .shot { transform: translateY(-6px); border-color: color-mix(in srgb, var(--c) 60%, transparent); box-shadow: 0 40px 80px -30px color-mix(in srgb, var(--c) 55%, transparent); }
  .work:hover .shot :global(.cover) { transform: scale(1.03); }
  .info { display: flex; align-items: center; gap: 14px; padding: 0 4px; }
  .go { flex: none; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; text-decoration: none; color: var(--muted); transition: background .25s, color .25s, border-color .25s, transform .25s; }
  .work:hover .go { background: var(--accent); border-color: var(--accent); color: #fff; transform: rotate(-45deg); }
  .txt { flex: 1; min-width: 0; }
  h3 { margin: 0; font-size: clamp(19px, 1.8vw, 23px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  h3 a { text-decoration: none; }
  p { margin: 3px 0 0; color: var(--dim); font-size: 14px; }
  .live { flex: none; font-size: 13px; color: var(--accent); text-decoration: none; padding: 7px 12px; border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 999px; transition: background .2s, color .2s; }
  .live:hover { background: var(--accent); color: #fff; }
</style>
