---
// Portada del proyecto: usa la imagen de `cover` si existe;
// si no, genera una portada con el color y el nombre del proyecto.
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index: number; tall?: boolean; }
const { project, index, tall = false } = Astro.props;
const p = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = p.cover ? (p.cover.startsWith('http') ? p.cover : `${base}${p.cover}`) : null;
const num = String(index + 1).padStart(2, '0');
---
<div class={`cover ${tall ? 'tall' : ''}`} style={`--c:${p.color}`}>
  {src ? (
    <img src={src} alt={`Captura de ${p.title}`} loading="lazy" />
  ) : (
    <div class="gen" aria-hidden="true">
      <span class="num mono">{num}</span>
      <span class="yr mono">{p.year}</span>
      <span class="word">{p.title}</span>
      <span class="orb"></span>
    </div>
  )}
</div>

<style>
  .cover { position: relative; container-type: inline-size; aspect-ratio: 16 / 10; background: var(--surface); overflow: hidden; }
  .cover.tall { aspect-ratio: 16 / 8; }
  img { width: 100%; height: 100%; object-fit: cover; }
  .gen {
    position: absolute; inset: 0;
    background:
      linear-gradient(transparent 0 calc(100% - 1px), color-mix(in srgb, var(--c) 18%, transparent) 0) 0 0 / 100% 32px,
      linear-gradient(90deg, transparent 0 calc(100% - 1px), color-mix(in srgb, var(--c) 18%, transparent) 0) 0 0 / 32px 100%,
      radial-gradient(70% 90% at 85% 10%, color-mix(in srgb, var(--c) 45%, #ff5b1f) 0%, transparent 70%),
      linear-gradient(160deg, color-mix(in srgb, color-mix(in srgb, var(--c) 40%, #ff5b1f) 45%, #0a0807), #0a0807 75%);
  }
  .orb { position: absolute; width: 60%; aspect-ratio: 1; right: -12%; top: -22%; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--c) 70%, transparent), transparent 65%); filter: blur(10px); opacity: 0.55; animation: drift 9s ease-in-out infinite alternate; }
  .word { position: absolute; left: 6%; bottom: 8%; right: 6%; font-size: 11cqi; font-weight: 800; font-stretch: 120%; letter-spacing: -0.04em; text-transform: uppercase; line-height: 0.9; color: var(--text); mix-blend-mode: normal; text-wrap: balance; }
  .tall .word { font-size: 8.5cqi; }
  .num, .yr { position: absolute; top: 18px; font-size: 12px; color: color-mix(in srgb, var(--c) 70%, white); }
  .num { left: 6%; }
  .yr { right: 6%; }
  @keyframes drift { to { transform: translate(-14%, 18%) scale(1.1); } }
</style>
